{
  "kind": "singleType",
  "collectionName": "footer",
  "info": {
    "singularName": "footer",
    "pluralName": "footers",
    "displayName": "Footer",
    "description": "Footer tagline and social media links"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "tagline": {
      "type": "text",
      "required": true
    },
    "quickLinks": {
      "type": "component",
      "component": "shared.link-item",
      "repeatable": true
    },
    "serviceLinks": {
      "type": "component",
      "component": "shared.link-item",
      "repeatable": true
    },
    "copyrightText": {
      "type": "string",
      "default": "Prime Capital S.C. — All Rights Reserved",
      "required": true
    },
    "linkedinUrl": {
      "type": "string"
    },
    "twitterUrl": {
      "type": "string"
    },
    "facebookUrl": {
      "type": "string"
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team Member",
    "description": "Board of Directors and Executive Management profiles shown on the Our Team page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Board of Directors",
        "Executive Management"
      ],
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0,
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "edu": {
      "type": "string",
      "required": true
    },
    "education": {
      "type": "component",
      "component": "shared.list-item",
      "repeatable": true
    },
    "summary": {
      "type": "text"
    },
    "qualifications": {
      "type": "text"
    },
    "occupation": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "appointed": {
      "type": "boolean",
      "default": false
    },
    "email": {
      "type": "email"
    },
    "exposure": {
      "type": "component",
      "component": "shared.list-item",
      "repeatable": true
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true
    }
  }
}

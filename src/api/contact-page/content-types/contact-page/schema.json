{
  "kind": "singleType",
  "collectionName": "contact_page",
  "info": {
    "singularName": "contact-page",
    "pluralName": "contact-pages",
    "displayName": "Contact Page",
    "description": "Editable contact details for the Contact Us page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "visitUsLabel": {
      "type": "string",
      "default": "Visit Us",
      "required": true
    },
    "address": {
      "type": "text",
      "required": true
    },
    "emailUsLabel": {
      "type": "string",
      "default": "Email Us",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "emailLabel": {
      "type": "string",
      "default": "general enquiry",
      "required": true
    },
    "orderEmail": {
      "type": "email"
    },
    "orderEmailLabel": {
      "type": "string",
      "default": "trade order",
      "required": true
    },
    "callUsLabel": {
      "type": "string",
      "default": "Call Us",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "businessHoursLabel": {
      "type": "string",
      "default": "Business Hours",
      "required": true
    },
    "weekdayHours": {
      "type": "string",
      "required": true,
      "default": "Monday - Friday, 8:00 AM - 5:00 PM EAT"
    },
    "saturdayHours": {
      "type": "string",
      "default": "Saturday, 8:00 AM - 12:00 PM EAT"
    },
    "mapEmbedUrl": {
      "type": "string",
      "required": true
    },
    "newClientInquiriesHeading": {
      "type": "string",
      "default": "New Client Inquiries",
      "required": true
    },
    "newClientInquiriesText": {
      "type": "text",
      "required": true
    },
    "careerOpportunitiesHeading": {
      "type": "string",
      "default": "Career Opportunities",
      "required": true
    },
    "careerOpportunitiesText": {
      "type": "text",
      "required": true
    }
  }
}

{
  "kind": "singleType",
  "collectionName": "about_page",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "About Page",
    "description": "Editable text and images for the About page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "overviewHeading": {
      "type": "string",
      "default": "Corporate Overview",
      "required": true
    },
    "overview": {
      "type": "richtext",
      "required": true
    },
    "visionTitle": {
      "type": "string",
      "default": "Vision 2030",
      "required": true
    },
    "vision": {
      "type": "text",
      "required": true
    },
    "missionTitle": {
      "type": "string",
      "default": "Mission",
      "required": true
    },
    "mission": {
      "type": "text",
      "required": true
    },
    "coreValuesHeading": {
      "type": "string",
      "default": "Core Values — The PRIME Principles",
      "required": true
    },
    "coreValues": {
      "type": "component",
      "component": "shared.title-description",
      "repeatable": true
    },
    "strategicContextHeading": {
      "type": "string",
      "default": "Strategic Context",
      "required": true
    },
    "strategicContext": {
      "type": "component",
      "component": "shared.title-description",
      "repeatable": true
    },
    "governanceHeading": {
      "type": "string",
      "default": "Governance & Organizational Structure",
      "required": true
    },
    "governanceCards": {
      "type": "component",
      "component": "shared.title-description",
      "repeatable": true
    },
    "csrHeading": {
      "type": "string",
      "default": "Corporate Social Responsibility",
      "required": true
    },
    "csrItems": {
      "type": "component",
      "component": "shared.title-description",
      "repeatable": true
    },
    "orgChartImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
